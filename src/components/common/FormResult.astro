---
/**
 * Success panel shown in place of a form after a successful submission.
 *
 * Hidden until initWeb3Form (src/lib/web3forms.ts) reveals it — it does NOT
 * manage its own visibility. `tabindex="-1"` exists so focus can be moved here
 * programmatically; without it the panel isn't focusable and a keyboard user is
 * stranded on the submit button that just disappeared.
 *
 * See how-to/form-feedback.md.
 */
interface Props {
  /** Must match the id passed to initWeb3Form's `successEl` lookup. */
  id: string
  title?: string
  body?: string
  /** Set to null to omit the "send another" button entirely. */
  resetLabel?: string | null
}

const {
  id,
  title = 'Thank you — your message is on its way.',
  body = "We've received it, and someone will get back to you within a couple of business days.",
  resetLabel = 'Send another message',
} = Astro.props
---

<div
  id={id}
  class="hidden rounded-2xl border border-[var(--border)] bg-[var(--card)] px-6 py-10 text-center focus:outline-none"
  role="status"
  aria-live="polite"
  tabindex="-1"
>
  <span
    class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[var(--primary)]"
  >
    <svg
      class="h-7 w-7 text-white"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 6 9 17l-5-5" />
    </svg>
  </span>

  <h2 class="mt-5 font-serif text-2xl text-[var(--foreground)]">{title}</h2>
  <p class="mx-auto mt-3 max-w-prose text-[var(--muted-foreground)]">{body}</p>

  {
    resetLabel && (
      <button
        type="button"
        data-form-reset
        class="mt-6 rounded-full border border-[var(--border)] px-6 py-2.5 text-sm font-semibold text-[var(--foreground)] transition-colors hover:bg-[var(--background)]"
      >
        {resetLabel}
      </button>
    )
  }
</div>
