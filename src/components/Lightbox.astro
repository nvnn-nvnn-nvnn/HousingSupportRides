---
/**
 * Lightbox — your build. Currently NOT wired into any page.
 *
 * To switch it on, in src/pages/gallery.astro:
 *   1. import Lightbox from '../components/Lightbox.astro'
 *   2. delete the inline <dialog> + <script> at the bottom
 *   3. drop <Lightbox /> in their place
 *
 * ⚠️ Don't do 1 and 3 without 2 — both copies use the same element ids, and
 * duplicate ids mean querySelector picks whichever comes first. Confusing.
 *
 * ── The contract ───────────────────────────────────────────────────────────
 *
 * This component knows NOTHING about content.ts, GalleryGrid, or Astro images.
 * It finds its photos entirely through markup that GalleryGrid already emits:
 *
 *   data-lightbox   a marker, no value — "I am clickable, open me"
 *   data-src        URL of the big render (fullSrc, ~2000px)
 *   data-alt        alt text, carried over so the dialog stays accessible
 *
 * That's the whole interface. Anything that reads those three works here.
 */
---

<dialog
  id="lightbox"
  class="m-auto max-h-[92vh] max-w-[95vw] overflow-hidden rounded-xl bg-[var(--background)] p-0 backdrop:bg-black/80"
>
  {/*
    `m-auto` is load-bearing: Tailwind's preflight sets `margin: 0` on every
    element, which clobbers the UA stylesheet's `margin: auto` that normally
    centers a modal dialog. Without it this pins to the top-left corner.
  */}
  <div class="relative">
    {/* Controls */}
    <div class="absolute right-3 top-3 z-10 flex items-center gap-1.5">
      <button
        id="lb-zoom-out"
        type="button"
        aria-label="Zoom out"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-black/60 text-lg font-semibold leading-none text-white hover:bg-black/80 disabled:cursor-not-allowed disabled:opacity-40"
      >−</button>
      <button
        id="lb-zoom-in"
        type="button"
        aria-label="Zoom in"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-black/60 text-lg font-semibold leading-none text-white hover:bg-black/80 disabled:cursor-not-allowed disabled:opacity-40"
      >+</button>
      <button
        id="lb-close"
        type="button"
        aria-label="Close image"
        class="rounded-full bg-black/60 px-3 py-1.5 text-sm font-medium text-white hover:bg-black/80"
      >Close</button>
    </div>

    {/*
      Prev / next. Here because arrow keys alone are invisible to touch users
      and to anyone who doesn't think to try them.
    */}
    <button
      id="lb-prev"
      type="button"
      aria-label="Previous photo"
      class="absolute left-3 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-xl leading-none text-white hover:bg-black/80 disabled:opacity-30"
    >‹</button>
    <button
      id="lb-next"
      type="button"
      aria-label="Next photo"
      class="absolute right-3 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-xl leading-none text-white hover:bg-black/80 disabled:opacity-30"
    >›</button>

    {/*
      Viewport — no scrollbars. The photo is moved with a CSS transform and
      panned by dragging. `touch-action: none` stops the browser hijacking
      drag/pinch for its own scrolling.
    */}
    <div
      id="lb-viewport"
      class="flex max-h-[92vh] max-w-[95vw] items-center justify-center overflow-hidden"
      style="touch-action: none;"
    >
      <img
        id="lb-img"
        src=""
        alt=""
        draggable="false"
        class="max-h-[92vh] w-auto max-w-full select-none will-change-transform"
      />
    </div>
  </div>
</dialog>

