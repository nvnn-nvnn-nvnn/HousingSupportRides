---
interface Props {
  eyebrow?: string
  title: string
  lead?: string
}

const { eyebrow, title, lead } = Astro.props
---

<header class="border-b border-[var(--border)] bg-[var(--card)]">
  <div class="mx-auto max-w-[1200px] px-5 py-20 md:px-16">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1
      class="mt-3 font-serif font-semibold"
      style="font-size: clamp(36px, 5vw, 56px); line-height: 1.1;"
    >
      {title}
    </h1>
    {
      lead && (
        <p class="mt-5 max-w-2xl text-[var(--muted-foreground)]" style="line-height: 1.78;">
          {lead}
        </p>
      )
    }
  </div>
</header>
