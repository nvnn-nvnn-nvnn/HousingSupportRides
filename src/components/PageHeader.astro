---
/**
 * Top-of-page header for every inner page.
 *
 * Two looks:
 *  - Plain (no `image`): sand card band, dark text. The original look.
 *  - Photo (`image` set): full-width photo behind a dark gradient, white text.
 *    `image` is a base path WITHOUT the size suffix, e.g. '/img/headers/driver'
 *    → expects /img/headers/driver-1080.jpg and -1920.jpg (16:7 crop).
 *    Make them with:  npm run img -- <photo> public/img/headers/<name> 16:7 1080,1920
 *
 * The photo is decorative here (the title says what the page is), so alt="".
 * See how-to/images.md → "Photo page headers".
 */
interface Props {
  eyebrow?: string
  title: string
  lead?: string
  image?: string
  /** CSS object-position for the photo, e.g. '50% 30%' to keep faces in frame. */
  focal?: string
}

const { eyebrow, title, lead, image, focal = '50% 40%' } = Astro.props
---

{
  image ? (
    <header class="relative isolate overflow-hidden bg-[#2a1416] text-white">
      <img
        src={`${image}-1920.jpg`}
        srcset={`${image}-1080.jpg 1080w, ${image}-1920.jpg 1920w`}
        sizes="100vw"
        alt=""
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        style={`object-position: ${focal};`}
      />
      {/* Two scrims: a left-to-right one so the text column always reads, and
          a bottom one so the header blends into the page below. */}
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/80 via-black/55 to-black/20" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/50 to-transparent" />

      <div class="mx-auto flex min-h-[340px] max-w-[1200px] flex-col justify-end px-5 pb-14 pt-24 md:min-h-[420px] md:px-16 md:pb-20">
        {eyebrow && (
          <p class="eyebrow" style="color: var(--primary-on-dark);">
            {eyebrow}
          </p>
        )}
        <h1
          class="mt-3 max-w-3xl font-serif font-semibold text-white"
          style="font-size: clamp(36px, 5vw, 60px); line-height: 1.08; text-shadow: 0 2px 24px rgba(0,0,0,0.35);"
        >
          {title}
        </h1>
        {lead && (
          <p class="mt-5 max-w-2xl text-white/90 md:text-lg" style="line-height: 1.7;">
            {lead}
          </p>
        )}
      </div>
    </header>
  ) : (
    <header class="border-b border-[var(--border)] bg-[var(--card)]">
      <div class="mx-auto max-w-[1200px] px-5 py-20 md:px-16">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1
          class="mt-3 font-serif font-semibold"
          style="font-size: clamp(36px, 5vw, 56px); line-height: 1.1;"
        >
          {title}
        </h1>
        {lead && (
          <p class="mt-5 max-w-2xl text-[var(--muted-foreground)]" style="line-height: 1.78;">
            {lead}
          </p>
        )}
      </div>
    </header>
  )
}
