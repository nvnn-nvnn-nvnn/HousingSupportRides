---
import '../styles/global.css'
import { GIVEBUTTER_ACCOUNT_ID, MISSION } from '../lib/content'

interface Props {
  title: string
  description?: string
  /**
   * Social share image (Facebook, LinkedIn, Slack, iMessage, X).
   * Root-relative — anything in public/ is served from /, so
   * public/img/social-card.jpg is '/img/social-card.jpg'.
   * Must be a raster: every platform rejects SVG here.
   */
  ogImage?: string
}

const {
  title,
  description = `Housing Support Rides — ${MISSION.short}`,
  ogImage = '/img/social-card.jpg',
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)

/**
 * Structured data for search engines and social previews. Tells Google (and
 * anything else that reads schema.org) that HSR is a nonprofit, what it does,
 * and how to reach it — which is what powers the knowledge panel and the
 * "donate" affordances in search results.
 */
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Housing Support Rides',
  alternateName: 'HSR',
  url: Astro.site?.toString(),
  description: MISSION.statement,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1351 3rd St E',
    addressLocality: 'Saint Paul',
    addressRegion: 'MN',
    postalCode: '55106',
    addressCountry: 'US',
  },
  telephone: '+1-763-501-7764',
  email: 'hsr@housingsupportrides.org',
  areaServed: 'Saint Paul, Minnesota',
  knowsAbout: [
    'Housing assistance',
    'Homelessness services',
    'Transportation assistance',
    'Community resource navigation',
  ],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Favicons generated from public/newlogo.png — see how-to/images.md.
        The old public/favicon.svg is the previous logo and is no longer used. */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />


    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Nonprofit structured data — see orgSchema above -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Givebutter donation widgets — only loads once GIVEBUTTER_ACCOUNT_ID
         is set in src/lib/content.ts. See how-to/deploying.md. -->
    {
      GIVEBUTTER_ACCOUNT_ID && (
        <script
          async
          src={`https://widgets.givebutter.com/latest.umd.cjs?acct=${GIVEBUTTER_ACCOUNT_ID}`}
        />
      )
    }

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
