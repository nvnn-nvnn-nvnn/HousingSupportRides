---
import SiteLayout from '../../layouts/SiteLayout.astro'
import PageHeader from '../../components/PageHeader.astro'
import Button from '../../components/ui/Button'
---

<SiteLayout
  title="Become a Driver — Housing Support Rides"
  description="Volunteer as a driver: give rides to work, appointments, and interviews on a schedule that fits your week."
>
  <PageHeader
    eyebrow="Volunteer"
    title="Become a Driver"
    lead="A reliable ride is often the one thing standing between someone and a job, a home, or a fresh start. Our drivers make that ride happen."
  />

  <section class="mx-auto max-w-[760px] px-5 py-16">
    <p class="text-[var(--muted-foreground)]" style="line-height: 1.78;">
      Placeholder intro — describe the driver program, the kinds of trips
      volunteers cover, and the difference it makes.
    </p>

    <h2 class="mt-12 font-serif text-2xl font-semibold">What you'll do</h2>
    <ul class="mt-4 space-y-2 text-[var(--muted-foreground)]">
      <li>Give rides to work, medical appointments, interviews, and errands.</li>
      <li>Pick trips that fit your own schedule — no minimum hours.</li>
      <li>Be a steady, friendly presence for someone rebuilding their routine.</li>
    </ul>

    <h2 class="mt-10 font-serif text-2xl font-semibold">What you'll need</h2>
    <ul class="mt-4 space-y-2 text-[var(--muted-foreground)]">
      <li>A valid driver's license and current insurance (placeholder).</li>
      <li>A reliable vehicle (mileage is reimbursed).</li>
      <li>To pass a background check (placeholder).</li>
    </ul>

    <div class="mt-12 rounded-xl border border-[var(--border)] bg-[var(--card)] p-8">
      <h3 class="font-sans text-xl font-semibold">Ready to start?</h3>
      <p class="mt-2 text-[var(--muted-foreground)]">
        Reach out and we'll walk you through onboarding.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <Button href="/volunteer/apply?role=driver">Apply to drive</Button>
        <Button href="/volunteer" variant="outline">All volunteer roles</Button>
      </div>
    </div>
  </section>
</SiteLayout>
