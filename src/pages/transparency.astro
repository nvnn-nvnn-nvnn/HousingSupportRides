---
import SiteLayout from '../layouts/SiteLayout.astro'
import PageHeader from '../components/PageHeader.astro'
import EmergencyNotice from '../components/EmergencyNotice.astro'
import FormResult from '../components/common/FormResult.astro'
import {
  TRANSPARENCY_DOCS,
  NONDISCRIMINATION,
  PROGRAM_REQUIREMENTS,
  WEB3FORMS_CONCERN_ACCESS_KEY,
} from '../lib/content'

/**
 * Accountability page: what we publish financially, who we serve, how to raise
 * a concern, and what to do in an emergency.
 *
 * Deliberate choices:
 *  - Documents with no `url` render as "not yet available" rather than a dead
 *    link. A transparency page that links nowhere is worse than one that says
 *    plainly what isn't ready.
 *  - PROGRAM_REQUIREMENTS is empty, so that section doesn't render at all.
 *    The nondiscrimination statement promises accuracy about requirements;
 *    inventing them would break that promise.
 */
const inputClass =
  'w-full rounded-lg border border-[var(--border)] bg-[var(--background)] px-4 py-3 text-[var(--foreground)] placeholder:text-[var(--muted-foreground)] focus:border-[var(--primary)] focus:outline-none focus:ring-2 focus:ring-[var(--accent-soft)]'

const available = TRANSPARENCY_DOCS.filter((d) => d.url)
const pending = TRANSPARENCY_DOCS.filter((d) => !d.url)
---

<SiteLayout
  title="Accountability & Transparency — Housing Support Rides"
  description="Our financial documents, nondiscrimination statement, and how to raise a concern about Housing Support Rides."
>
  <PageHeader
    eyebrow="Accountability"
    title="Transparency & Your Rights"
    lead="What we publish, who we serve, and how to tell us when something is wrong."
  />

  <div class="mx-auto max-w-[760px] px-5 pb-24">
    <!-- Emergency first: this page is linked from the footer, so someone in
         crisis may land here looking for help. -->
    <EmergencyNotice class="mt-4" />

    <!-- Financial transparency -->
    <section id="financials" class="mt-16 scroll-mt-28">
      <h2 class="font-serif text-2xl font-semibold md:text-3xl">Financial transparency</h2>
      <p class="mt-4 text-[var(--muted-foreground)]" style="line-height: 1.78;">
        Housing Support Rides, Inc. is a nonprofit charitable organization in
        Saint Paul, Minnesota (NPI 1801751094). We publish our financial
        documents here as they become available.
      </p>

      {
        available.length > 0 && (
          <ul class="mt-6 grid gap-3">
            {available.map((doc) => (
              <li class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-5">
                <a
                  href={doc.url}
                  class="font-semibold text-[var(--primary)] underline hover:opacity-70"
                >
                  {doc.label}
                </a>
                <p class="mt-1 text-sm text-[var(--muted-foreground)]">{doc.note}</p>
              </li>
            ))}
          </ul>
        )
      }

      {
        pending.length > 0 && (
          <div class="mt-6 rounded-xl border border-[var(--border)] bg-[var(--card)] p-5 md:p-6">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-[var(--muted-foreground)]">
              Not yet published
            </h3>
            <p class="mt-3 text-sm text-[var(--muted-foreground)]">
              We are a young organization and these are not all ready yet. We would
              rather say so than show you a broken link. Each will be posted here
              once it exists — and you can request any of them in the meantime.
            </p>
            <ul class="mt-4 grid gap-3">
              {pending.map((doc) => (
                <li>
                  <p class="font-semibold text-[var(--foreground)]">{doc.label}</p>
                  <p class="text-sm text-[var(--muted-foreground)]">{doc.note}</p>
                </li>
              ))}
            </ul>
            <p class="mt-5 text-sm text-[var(--muted-foreground)]">
              To request a document, email{' '}
              <a
                href="mailto:hsr.intake@gmail.com?subject=Document%20request"
                class="font-medium text-[var(--primary)] underline hover:opacity-70"
              >
                hsr.intake@gmail.com
              </a>
              .
            </p>
          </div>
        )
      }
    </section>

    <!-- Nondiscrimination -->
    <section id="nondiscrimination" class="mt-16 scroll-mt-28">
      <h2 class="font-serif text-2xl font-semibold md:text-3xl">
        Nondiscrimination statement
      </h2>
      <p class="mt-4 text-lg text-[var(--foreground)]" style="line-height: 1.7;">
        {NONDISCRIMINATION.statement}
      </p>
      <p class="mt-4 text-[var(--muted-foreground)]" style="line-height: 1.78;">
        {NONDISCRIMINATION.commitment}
      </p>

      {
        PROGRAM_REQUIREMENTS.length > 0 && (
          <div class="mt-8">
            <h3 class="font-serif text-xl font-semibold">Program requirements</h3>
            <p class="mt-2 text-sm text-[var(--muted-foreground)]">
              Some programs do have practical requirements. These apply to
              everyone equally, and we list them so there are no surprises.
            </p>
            <div class="mt-5 grid gap-5">
              {PROGRAM_REQUIREMENTS.map((entry) => (
                <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-5">
                  <p class="font-semibold text-[var(--foreground)]">{entry.program}</p>
                  <ul class="mt-2 grid gap-1.5 pl-5 text-[var(--muted-foreground)]" style="list-style: disc;">
                    {entry.requirements.map((r) => (
                      <li>{r}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </section>

    <!-- Concern / complaint -->
    <section id="concern" class="mt-16 scroll-mt-28">
      <h2 class="font-serif text-2xl font-semibold md:text-3xl">
        Report a concern
      </h2>
      <p class="mt-4 text-[var(--muted-foreground)]" style="line-height: 1.78;">
        If you have a safety concern, or you feel you were treated unfairly by
        anyone at Housing Support Rides, please tell us. You can leave your name
        out — the only required field is your message.
      </p>

      <form id="concern-form" class="mt-6 grid gap-5">
        <input
          type="hidden"
          name="subject"
          value="CONCERN REPORT — Housing Support Rides"
        />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <label class="grid gap-2 text-sm font-medium text-[var(--foreground)]">
          What happened? <span class="font-normal text-[var(--muted-foreground)]">(required)</span>
          <textarea
            class={inputClass}
            name="message"
            rows="6"
            required
            placeholder="Tell us what happened, and when. Include as much or as little as you want."></textarea>
        </label>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-medium text-[var(--foreground)]">
            Your name <span class="font-normal text-[var(--muted-foreground)]">(optional)</span>
            <input class={inputClass} type="text" name="name" autocomplete="name" placeholder="Leave blank to stay anonymous" />
          </label>
          <label class="grid gap-2 text-sm font-medium text-[var(--foreground)]">
            Email or phone <span class="font-normal text-[var(--muted-foreground)]">(optional)</span>
            <input class={inputClass} type="text" name="contact" placeholder="Only if you want a reply" />
          </label>
        </div>

        <p class="text-sm text-[var(--muted-foreground)]">
          If you leave no contact details we cannot follow up with you, but we
          will still look into it.
        </p>

        <div>
          <button
            type="submit"
            class="rounded-full bg-[var(--accent-warm)] px-7 py-3.5 font-semibold text-white transition-all duration-200 hover:brightness-95 active:brightness-90 disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send report
          </button>
          <p id="concern-form-status" class="mt-3 text-sm text-[var(--muted-foreground)]" role="status"></p>
        </div>
      </form>

      <FormResult
        id="concern-form-success"
        title="Thank you for telling us."
        body="Your report has been sent. If you left contact details, someone will follow up with you directly."
        resetLabel={null}
      />

      <script>
        import { initWeb3Form } from '../lib/web3forms'
        import { WEB3FORMS_CONCERN_ACCESS_KEY } from '../lib/content'

        const form = document.querySelector<HTMLFormElement>('#concern-form')
        const status = document.querySelector<HTMLElement>('#concern-form-status')
        const success = document.querySelector<HTMLElement>('#concern-form-success')
        if (form && status)
          initWeb3Form(form, status, {
            successEl: success,
            accessKey: WEB3FORMS_CONCERN_ACCESS_KEY,
          })
      </script>

      {
        !WEB3FORMS_CONCERN_ACCESS_KEY && (
          <p class="mt-6 rounded-lg border border-[var(--border)] bg-[var(--card)] p-4 text-sm text-[var(--muted-foreground)]">
            You can also raise a concern in writing to Housing Support Rides,
            Inc., 1351 3rd St E, Saint Paul, MN 55106.
          </p>
        )
      }
    </section>
  </div>
</SiteLayout>
