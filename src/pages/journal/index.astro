---
import { getCollection } from 'astro:content'
import SiteLayout from '../../layouts/SiteLayout.astro'
import MediaPlaceholder from '../../components/common/MediaPlaceholder'

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
)

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<SiteLayout
  title="Journal — Housing Support Rides"
  description="Field updates, water quality results, and stories from the watershed."
>
  <!-- Page header -->
  <header class="border-b border-[var(--border)] bg-[var(--card)]">
    <div class="mx-auto max-w-[1200px] px-5 py-20 md:px-16">
      <p class="eyebrow">The Journal</p>
      <h1
        class="mt-3 font-serif font-semibold"
        style="font-size: clamp(38px, 5vw, 64px); line-height: 1.1;"
      >
        Dispatches from the watershed
      </h1>
      <p class="mt-5 max-w-2xl text-[var(--muted-foreground)]" style="line-height: 1.78;">
        Field updates, water quality results, and the occasional call to show up
        somewhere. Reporting from the 340 miles of river we monitor, restore, and
        defend.
      </p>
    </div>
  </header>

  <!-- Post grid -->
  <div class="mx-auto max-w-[1200px] px-5 py-16 md:px-16">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <article class="group flex flex-col overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--card)]">
            <a href={`/journal/${post.id}`} class="block overflow-hidden">
              <div class="aspect-[16/10] transition-transform duration-500 group-hover:scale-105">
                <MediaPlaceholder
                  alt={post.data.coverAlt ?? post.data.title}
                  chip={false}
                  className="h-full"
                />
              </div>
            </a>
            <div class="flex flex-1 flex-col p-6">
              <span class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--primary)]">
                {post.data.category}
              </span>
              <h2 class="mt-2 font-serif text-2xl font-semibold leading-tight">
                <a href={`/journal/${post.id}`} class="transition-colors hover:text-[var(--primary)]">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 flex-1 text-[var(--muted-foreground)]">{post.data.excerpt}</p>
              <p class="mt-5 text-sm text-[var(--muted-foreground)]">
                {dateFmt.format(post.data.publishedAt)} · {post.data.author}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</SiteLayout>
