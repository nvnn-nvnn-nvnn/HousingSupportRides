---
import { getCollection, render } from 'astro:content'
import SiteLayout from '../../layouts/SiteLayout.astro'
import MediaPlaceholder from '../../components/common/MediaPlaceholder'

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<SiteLayout
  title={`${post.data.title} — Housing Support Rides`}
  description={post.data.excerpt || post.data.title}
>
  <article class="pb-24">
    <!-- Article header -->
    <header class="border-b border-[var(--border)] bg-[var(--card)]">
      <div class="mx-auto max-w-[760px] px-5 py-16">
        <a
          href="/journal"
          class="text-sm font-medium text-[var(--primary)] transition-opacity hover:opacity-70"
        >
          ← Back to the Journal
        </a>
        <p class="eyebrow mt-6">{post.data.category}</p>
        <h1
          class="mt-3 font-serif font-semibold"
          style="font-size: clamp(32px, 4.5vw, 52px); line-height: 1.12;"
        >
          {post.data.title}
        </h1>
        <p class="mt-5 text-[var(--muted-foreground)]">
          By {post.data.author} · {dateFmt.format(post.data.publishedAt)}
        </p>
      </div>
    </header>

    <!-- Cover -->
    <div class="mx-auto max-w-[900px] px-5">
      <div class="-mt-8 overflow-hidden rounded-xl shadow-sm md:-mt-10">
        <div class="aspect-[16/9]">
          <MediaPlaceholder
            alt={post.data.coverAlt ?? post.data.title}
            hint={post.data.coverAlt ?? undefined}
            className="h-full"
          />
        </div>
      </div>
    </div>

    <!-- Body -->
    <div class="article-body mx-auto mt-12 max-w-[680px] px-5">
      <Content />
    </div>
  </article>
</SiteLayout>
