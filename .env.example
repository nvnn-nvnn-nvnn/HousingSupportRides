# Admin dashboard configuration. Copy to `.env` for local overrides, and set
# the same keys in Vercel → Project → Settings → Environment Variables.
# `.env` is gitignored. NEVER commit real values. See how-to/admin-dashboard.md.

# --- Database (Turso / libSQL) ---------------------------------------------
# Leave blank locally to use ./local.db automatically.
# Production REQUIRES a Turso URL — Vercel can't keep a local file.
#   turso db show hsr-admin --url
DATABASE_URL=
#   turso db tokens create hsr-admin
DATABASE_AUTH_TOKEN=

# --- Auth --------------------------------------------------------------------
# Signs session cookies. 32+ random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs every admin out.
BETTER_AUTH_SECRET=

# The site's own public URL. Sign-in requests from any other origin are
# rejected, so this must match exactly what's in the browser bar.
#   production:  https://housingsupportrides.org
#   local:       http://localhost:4321
BETTER_AUTH_URL=
